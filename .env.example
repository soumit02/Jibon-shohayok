# ===== LLM (same style as the Leo project) =====
GROQ_API_KEY="your api key"
BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b

FALLBACK_API_KEY="your api key"
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL_NAME=openai/gpt-oss-20b

# ===== Embeddings (Gemini API) =====
GEMINI_API_KEY="your gemini key"
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_TPM_BUDGET=20000

# ===== RAG =====
RAG_COLLECTION=gov_procedures
RAG_TOP_K=5
RAG_MIN_SCORE=0.65

# ===== Database =====
DATABASE_URL=sqlite:///./local.db

# ===== API =====
ALLOWED_ORIGINS=*

# ===== NEW in Day 2 =====
# any long random text; it signs the login tokens. Change it before going live!
JWT_SECRET=change-this-to-a-long-random-text
JWT_EXPIRE_HOURS=72
MAX_UPLOAD_MB=3
# how many times the Planning crew may re-plan when the first plan is over budget
MAX_REPLANS=1
# how many earlier messages are sent to the AI as short-term memory
CHAT_HISTORY_TURNS=6
